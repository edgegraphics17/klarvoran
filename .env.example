# --- Öffentliche Site-Konfiguration (client- und serverseitig sichtbar) ---

# Kanonische Domain der Website. Hinweis: Die vorhandene Visitenkarte nennt
# "www.mscoaching.com", die E-Mail-Adresse nutzt aber die Domain "mscoaching.de".
# Bitte vor Go-Live klären, welche Domain tatsächlich registriert/aktiv ist.
NEXT_PUBLIC_SITE_URL=https://www.mscoaching.de

# Kontaktdaten. Defaults in lib/site-config.ts stammen von der vorhandenen
# Visitenkarte (Mazhar Said) und sollten vor Go-Live von Mazhar bestätigt werden.
NEXT_PUBLIC_PHONE_DISPLAY="+49 177 9548140"
NEXT_PUBLIC_EMAIL="hello@mscoaching.de"
# Nur Ziffern inkl. Ländervorwahl, ohne "+" – für wa.me-Links. Wird sonst aus
# NEXT_PUBLIC_PHONE_DISPLAY abgeleitet.
NEXT_PUBLIC_WHATSAPP_NUMBER=491779548140

# Externe Kalender-Integration (z. B. Cal.com/Calendly-Buchungsseite). Wenn nicht
# gesetzt, wird ausschließlich das Terminanfrage-Formular auf /termin verwendet.
NEXT_PUBLIC_BOOKING_URL=

# --- Serverseitige Konfiguration (niemals im Client sichtbar) ---

# Lead-Versand-Adapter: mindestens einen der folgenden zwei konfigurieren, damit
# Formulare in Production tatsächlich zustellen. Ohne Konfiguration läuft die
# Website in Production weiter, meldet Anfragen aber ehrlich als "aktuell nicht
# übermittelbar" und verweist auf Telefon/E-Mail/WhatsApp statt einen Erfolg
# vorzutäuschen. In Development wird stattdessen ein klar gekennzeichneter
# Fallback in die Server-Konsole geloggt.

# Option A: Resend (https://resend.com) – HTTP-API, kein SDK nötig
RESEND_API_KEY=
LEAD_SENDER_EMAIL="MS Coaching Website <onboarding@resend.dev>"

# Option B: Generischer Webhook (z. B. Zapier, Make, eigenes CRM)
FORM_WEBHOOK_URL=

# Empfänger-Adresse für eingehende Leads (Default: NEXT_PUBLIC_EMAIL)
LEAD_RECIPIENT_EMAIL=
